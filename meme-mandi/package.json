{
  "name": "memt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "demo:setup": "tsx scripts/setup-demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/integration-test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/client": "6.19.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^10.0.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "prisma": "6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "^3.20.0"
  }
}
