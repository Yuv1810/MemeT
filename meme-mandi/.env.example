DATABASE_URL="postgresql://postgres:change-me@127.0.0.1:5432/memt?schema=public&connection_limit=5"
APP_URL="http://127.0.0.1:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-64-character-secret"
# local writes emails to .local-mail; smtp uses Nodemailer; resend uses HTTPS.
MAIL_PROVIDER="local"
MAIL_FROM="MemT <hello@your-verified-domain.com>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
RESEND_API_KEY=""
# Official public API adapter. Confirm endpoint/token with your Qikink account.
QIKINK_API_URL="https://qikink.com/erp2/index.php/api/createOrder"
QIKINK_AUTH_TOKEN=""
QIKINK_ENABLED="false"
# Set these temporarily and run npm run admin:create. Never use sample credentials.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Store owner"
